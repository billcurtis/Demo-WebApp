# Copy to terraform.tfvars (git-ignored) only if you run Terraform by hand.
# bootstrap.ps1 passes these values on the command line instead.

subscription_id   = "00000000-0000-0000-0000-000000000000"
location          = "eastus"
prefix            = "bill-demo-webapp"
environment       = "dev"
github_owner      = "billcurtis"
github_repository = "Demo-WebApp"
github_branch     = "main"
state_key         = "cloud-gone-wild/dev/app.tfstate"

# From: gh api repos/billcurtis/Demo-WebApp/actions/oidc/customization/sub --jq .sub_claim_prefix
github_oidc_subject_prefix = "repo:billcurtis@7672827/Demo-WebApp@1430058167"
